<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- C01 퀘스트 설정 (김민승) - QuestDAO 에서 mybatis.selectList("quest.selectActiveQuests") 처럼 부름 -->
<mapper namespace="quest">

	<!-- 사용 중인 퀘스트 목록 (번호 순) -->
	<select id="selectActiveQuests" resultType="com.example.demo.quest.QuestDTO">
		SELECT QUEST_ID, QUEST_NAME, QUEST_TYPE, TARGET_VALUE, DESCRIPTION
		FROM QUEST
		WHERE IS_ACTIVE = 'Y'
		ORDER BY QUEST_ID
	</select>

	<!-- 내 인생이고 진행 중(PLAYING)이고 아직 0살(태어난 직후)이면 1
	     → 나중에 다 산 뒤 쉬운 퀘스트를 고르는 꼼수 막기 -->
	<select id="countMyPlayingLife" parameterType="map" resultType="int">
		SELECT COUNT(*) FROM LIFE
		WHERE LIFE_ID = #{lifeId} AND MEMBER_ID = #{memberId} AND STATUS = 'PLAYING'
		  AND NVL(CURRENT_AGE, 0) = 0
	</select>

	<!-- 이 인생에 이미 정해진 퀘스트 개수 -->
	<select id="countLifeQuests" parameterType="int" resultType="int">
		SELECT COUNT(*) FROM LIFE_QUEST WHERE LIFE_ID = #{lifeId}
	</select>

	<!-- 사용 중인 퀘스트면 1 -->
	<select id="countActiveQuest" parameterType="int" resultType="int">
		SELECT COUNT(*) FROM QUEST WHERE QUEST_ID = #{questId} AND IS_ACTIVE = 'Y'
	</select>

	<!-- 고른 퀘스트 저장 (ACHIEVED 는 NULL = 아직 판정 전, POINT_GIVEN 은 기본값 'N') -->
	<insert id="insertLifeQuest" parameterType="map">
		INSERT INTO LIFE_QUEST (LIFE_ID, QUEST_ID)
		VALUES (#{lifeId}, #{questId})
	</insert>

</mapper>
